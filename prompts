I have a guarantor. I can repay in 10 months.
"""

  example_json = {
      "applicant_name": "Tetteh Quayenortey",
      "amount_ghs": 5000,
      "purpose": "buy new sewing machines",
      "monthly_profit_ghs": 1000,
      "has_collateral_or_guarantor": True,
      "repayment_months": 10
  }

  system_prompt = (
      "You are a highly efficient data extraction bot. Your sole task is to extract specific information "
